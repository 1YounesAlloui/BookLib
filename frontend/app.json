{
  "expo": {
    "name": "BookLib",
    "slug": "booklib",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "booklib",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.booklib.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d10"
      }
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d10"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f7f8ca1-2c50-4334-9492-d274b28db70d"
      }
    },
    "owner": "ayounes55",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0f7f8ca1-2c50-4334-9492-d274b28db70d"
    },
    "ios": {}
  }
}
